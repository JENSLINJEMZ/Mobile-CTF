# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgresql://ctf:ctf@localhost:5432/ctf_dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Auth (Stage 2) ----
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
BCRYPT_ROUNDS=12
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GENERAL=100

# ---- Sandbox (Stage 6) ----
SANDBOX_SERVICE_URL=http://localhost:8080

# ---- Object storage (Stage 9) ----
OBJECT_STORAGE_BUCKET=ctf-platform-dev
OBJECT_STORAGE_ENDPOINT=

# ---- API URL consumed by the mobile app ----
EXPO_PUBLIC_API_URL=http://localhost:4000