{
  "name": "@ctf/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, client singleton, and seed scripts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx seed/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src seed"
  },
  "prisma": {
    "seed": "tsx seed/index.ts"
  },
  "dependencies": {
    "@ctf/shared": "^0.1.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  }
}
